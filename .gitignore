# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz
*.bbl
*.blg

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# Data (per proposal §4.2: pin Kaggle version + commit downloaded files;
# but for now we don't want 96 MB of raw CSV in git history)
data/raw/*.csv
data/raw/*.zip
data/processed/returns_matrix.csv

# Per-config experiment artifacts (compressed.npz, projection.npz, ...).
# These are reproducible from the seed + the recipe in the runner script.
# Keep aggregated CSVs in results/, but not the thousands of per-run files.
results/*/runs/

# Cloud-pulled artifact tree (mirror of remote runs/, ~5 GB)
data/cloud_artifacts/

# Keep the directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
